{
  "projectId": "a5a10ff1-2619-49c3-b5db-629370a812c2",
  "shape": "package",
  "pkg": "miyrah",
  "globalName": "Miyrah",
  "buildCmd": "npm run build && node .design-sync/prepare-css.mjs",
  "entry": ".design-sync/entry.ts",
  "srcDir": "src/components",
  "tsconfig": "tsconfig.app.json",
  "cssEntry": "dist/assets/_ds_styles.css",
  "extraEntries": [".design-sync/provider.tsx"],
  "provider": { "component": "DesignSyncProvider" },
  "readmeHeader": ".design-sync/conventions.md",
  "overrides": {
    "FilterBar": { "cardMode": "column" },
    "PeriodFilter": { "cardMode": "column" },
    "Checkbox": { "cardMode": "column" },
    "LineChart": { "cardMode": "column" },
    "MemberPicker": { "cardMode": "column" },
    "MetricCard": { "cardMode": "column" },
    "FormDrawer": { "cardMode": "column" },
    "PieChart": { "cardMode": "column" },
    "FilterTabs": { "cardMode": "column" },
    "Dialog": { "cardMode": "single", "primaryStory": "ConfirmDelete" },
    "Popover": { "cardMode": "single", "primaryStory": "BalanceDetails" },
    "Select": { "cardMode": "single", "primaryStory": "Open" },
    "ConfirmModal": { "cardMode": "single", "primaryStory": "DeleteTransaction" }
  },
  "componentSrcMap": {
    "Button": "src/components/ui/button.tsx",
    "Badge": "src/components/ui/badge.tsx",
    "Input": "src/components/ui/input.tsx",
    "Textarea": "src/components/ui/textarea.tsx",
    "Label": "src/components/ui/label.tsx",
    "Checkbox": "src/components/ui/checkbox.tsx",
    "Avatar": "src/components/ui/avatar.tsx",
    "Separator": "src/components/ui/separator.tsx",
    "Skeleton": "src/components/ui/skeleton.tsx",
    "Select": "src/components/ui/select.tsx",
    "Popover": "src/components/ui/popover.tsx",
    "Dialog": "src/components/ui/dialog.tsx",
    "Sheet": "src/components/ui/sheet.tsx",
    "Command": "src/components/ui/command.tsx",
    "Field": "src/components/ui/field.tsx",
    "InputGroup": "src/components/ui/input-group.tsx",
    "Table": "src/components/ui/table.tsx",
    "Form": "src/components/ui/form.tsx",
    "Tabs": "src/components/tabs/tabs.tsx",
    "FilterTabs": "src/components/tabs/filter-tabs.tsx",
    "MetricCard": "src/components/metric-card/metric-card.tsx",
    "DataTable": "src/components/data-table/data-table.tsx",
    "LineChart": "src/components/line-chart/line-chart.tsx",
    "PieChart": "src/components/pie-chart/pie-chart.tsx",
    "Pagination": "src/components/pagination/pagination.tsx",
    "FilterBar": "src/components/filter-bar/filter-bar.tsx",
    "PeriodFilter": "src/components/filter-bar/period-filter.tsx",
    "TypeFilter": "src/components/filter-bar/type-filter.tsx",
    "CategoryFilter": "src/components/filter-bar/category-filter.tsx",
    "MinistryFilter": "src/components/filter-bar/ministry-filter.tsx",
    "SearchFilter": "src/components/filter-bar/search-filter.tsx",
    "MemberPicker": "src/components/member-picker/member-picker.tsx",
    "MemberAvatar": "src/components/avatar/avatar.tsx",
    "ConfirmModal": "src/components/modal-form/confirm-modal.tsx",
    "FormDrawer": "src/components/modal-form/form-drawer.tsx",
    "SideBar": "src/components/side-bar/side-bar.tsx",
    "AuthLayout": "src/components/auth-layout/auth-layout.tsx"
  }
}
